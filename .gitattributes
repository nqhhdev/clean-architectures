# Normalise line endings and mark generated code so reviews can skip it.
* text=auto eol=lf

*.png binary
*.jpg binary
*.ttf binary
*.otf binary

# Generated by build_runner / gen-l10n (also git-ignored; listed so that anything
# committed by mistake stays collapsed in diffs).
*.g.dart linguist-generated=true -diff
*.freezed.dart linguist-generated=true -diff
flutter/lib/ui/core/l10n/generated/** linguist-generated=true -diff
flutter/pubspec.lock linguist-generated=true
